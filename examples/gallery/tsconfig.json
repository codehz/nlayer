{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@nlayer",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "typeRoots": ["./node_modules/@nlayer", "./node_modules/@types"],
    "types": ["globals"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
